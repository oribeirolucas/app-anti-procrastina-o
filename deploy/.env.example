# ── Instalação do cliente ───────────────────────────────────────
# Domínio já apontado (registro A) para o IP desta VPS. Ex.: crm.cliente.com.br
DOMINIO=crm.cliente.com.br
# E-mail para avisos do certificado HTTPS (Let's Encrypt)

# Senha do banco: gere com  openssl rand -base64 24  (não reutilize entre clientes)
DB_SENHA=

# Admin inicial (criado só se ainda não existir). Troque a senha no primeiro acesso.
ADMIN_EMAIL=
ADMIN_SENHA=

FUSO_HORARIO=America/Sao_Paulo
SESSAO_HORAS=12
# Segredo do /tarefas/processar (opcional). Gere com  openssl rand -hex 24
CRON_SECRET=

# Agentes de IA (Claude). Vazio = agentes desligados; o cliente recebe a mensagem padrão e vai para humano.
ANTHROPIC_API_KEY=
MODELO_IA_PADRAO=claude-opus-5-5

# WhatsApp Cloud API (Meta) — passo a passo em docs/WHATSAPP.md
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Transcrição dos áudios do WhatsApp (ChatGPT). Vazio = áudio não é transcrito.
OPENAI_API_KEY=
OPENAI_MODELO_TRANSCRICAO=gpt-4o-transcribe

# ── Backup ──────────────────────────────────────────────────────
# Hora do backup diário (00–23, no FUSO_HORARIO acima) e quantos dias manter na VPS
BACKUP_HORA=03
BACKUP_RETENCAO_DIAS=14
# Cópia fora da VPS (recomendado). Exemplo Backblaze B2 / S3 compatível:
#   RCLONE_TIPO=s3  RCLONE_PROVEDOR=Other  RCLONE_ENDPOINT=https://s3.us-west-004.backblazeb2.com
#   RCLONE_DESTINO=remoto:meu-bucket/cliente-x
RCLONE_DESTINO=
RCLONE_TIPO=
RCLONE_PROVEDOR=
RCLONE_CHAVE=
RCLONE_SEGREDO=
RCLONE_ENDPOINT=
RCLONE_REGIAO=
