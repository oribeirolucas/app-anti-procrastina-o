# Banco PostgreSQL
DATABASE_URL=postgresql://app:app@localhost:5432/plataforma

# Porta HTTP do servidor
PORT=3000
NODE_ENV=development

# Origem do front-end (proteção CSRF). Em produção: https://seu-dominio
ORIGEM_APP=http://localhost:5173

# Sessão (horas) e fuso padrão (pode ser alterado no painel admin)
SESSAO_HORAS=12
FUSO_HORARIO=America/Sao_Paulo

# Admin inicial criado pelo seed (troque a senha após o primeiro login)
ADMIN_EMAIL=admin@exemplo.com
ADMIN_SENHA=TroqueEstaSenha123

# Atrás de proxy (Vercel, Caddy/Nginx): usar o IP real do cliente em limites de tentativas
TRUST_PROXY=0
# Processador de automações em segundo plano, em segundos (0 desliga). Na Vercel não há processo contínuo.
WORKER_INTERVALO_S=30
# Segredo do endpoint /tarefas/processar para agendador externo (vazio = endpoint desativado)
CRON_SECRET=

# ── Agentes de IA e WhatsApp (docs/WHATSAPP.md) ──
# Chave da API da Anthropic (Claude). Vazio = agentes não respondem; o cliente recebe a mensagem padrão.
ANTHROPIC_API_KEY=
# Modelo usado ao criar os agentes padrão (cada agente pode trocar em Agentes IA)
MODELO_IA_PADRAO=claude-opus-5-5
# WhatsApp Cloud API (Meta). Sem token/ID do número, nada é enviado (as respostas ficam registradas no Inbox).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Segredo do app Meta: valida a assinatura X-Hub-Signature-256 de cada webhook
WHATSAPP_APP_SECRET=
# Texto livre que você define e cola no painel da Meta ao cadastrar o webhook
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSAO=v21.0
# Transcrição dos áudios do WhatsApp (ChatGPT/OpenAI). Vazio = áudio não é transcrito; o agente pede texto.
OPENAI_API_KEY=
OPENAI_MODELO_TRANSCRICAO=gpt-4o-transcribe

# Plano Rede: máximo de unidades ativas nesta instalação
LIMITE_UNIDADES=3
